   "source": [
    "## RFM 分层\n",
    "这里 R：最近一次购买距今天数，F：购买频次，M 在数据集中无金额，可用购买次数替代（或假定 M=F）。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0f0333ce",
   "metadata": {
    "vscode": {
     "languageId": "sql"
    }
   },
   "outputs": [],
   "source": [
    "import datetime\n",
    "snapshot_date = pd.Timestamp('2017-12-04')\n",
    "buy_data = df[df.behavior=='buy']\n",
    "rfm = buy_data.groupby('user_id').agg(\n",
    "    last_buy=('date', 'max'),\n",
    "    freq=('user_id', 'count')\n",
    ").reset_index()\n",
    "rfm['recency'] = (snapshot_date - pd.to_datetime(rfm['last_buy'])).dt.days\n",
    "rfm['F_score'] = pd.qcut(rfm['freq'], 3, labels=[1,2,3])\n",
    "rfm['R_score'] = pd.qcut(rfm['recency'].rank(method='first'), 3, labels=[3,2,1])  # 注意越近分越高\n",
    "rfm['RFM'] = rfm['R_score'].astype(str) + rfm['F_score'].astype(str)\n",
    "print(rfm.groupby('RFM')['user_id'].count())"
   ]
  }
