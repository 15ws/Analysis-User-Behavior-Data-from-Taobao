    "# 导入数据与基本清洗"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4560a290",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy  as np\n",
    "import sqlite3\n",
    "# 读取\n",
    "df = pd.read_csv('UserBehavior.csv',names=['user_id','item_id','category_id','behavior','timestamp'],header=None)\n",
    "\n",
    "# 原始 timestamp 是Unix秒数\n",
    "df['timestamp'] = pd.to_datetime(df['timestamp'], unit='s')\n",
    "df['date'] = df['timestamp'].dt.date\n",
    "df['hour'] = df['timestamp'].dt.hour\n",
    "\n",
    "# 查看缺失值和重复值\n",
    "print(df.isnull().sum())\n",
    "df.drop_duplicates(inplace=True)\n",
    "\n",
    "# 删除异常时间（如超出范围）\n",
    "df = df[(df['timestamp'] >= '2017-11-25') & (df['timestamp'] <= '2017-12-03')]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0da99775",
   "metadata": {},
   "source": [
    "# SQL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8e0397c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 清洗后的 DataFrame 导入 SQLite\n",
    "\n",
    "conn = sqlite3.connect(':memory:')\n",
    "df.to_sql('user_behavior', conn, index=False, if_exists='replace')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "57cca986",
   "metadata": {},
   "source": [
    "## 用SQL计算PV、UV、跳失率"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5a339760",
   "metadata": {},
   "outputs": [],
   "source": [
    "query_pv_uv = \"\"\"\n",
    "SELECT \n",
    "    date,\n",
    "    COUNT(*) AS pv,\n",
    "    COUNT(DISTINCT user_id) AS uv,\n",
    "    ROUND(CAST(COUNT(*) AS FLOAT) / COUNT(DISTINCT user_id), 2) AS avg_pv_per_user\n",
    "FROM user_behavior\n",
    "WHERE behavior = 'pv'\n",
    "GROUP BY date\n",
    "ORDER BY date;\n",
    "\"\"\"\n",
    "# 执行SQL并转回dataframe\n",
    "pv_uv_df = pd.read_sql(query_pv_uv, conn)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9f17a741",
   "metadata": {},
   "source": [
    "## 漏斗分析"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f19927f6",
   "metadata": {},
   "outputs": [],
   "source": [
    "funnel_query = \"\"\"\n",
    "SELECT \n",
    "    '1-点击' AS stage, COUNT(DISTINCT user_id) AS users FROM user_behavior WHERE behavior='pv'\n",
    "UNION ALL\n",
    "SELECT \n",
    "    '2-收藏', COUNT(DISTINCT user_id) FROM user_behavior WHERE behavior='fav'\n",
    "UNION ALL\n",
    "SELECT \n",
    "    '3-加购', COUNT(DISTINCT user_id) FROM user_behavior WHERE behavior='cart'\n",
    "UNION ALL\n",
    "SELECT \n",
    "    '4-购买', COUNT(DISTINCT user_id) FROM user_behavior WHERE behavior='buy';\n",
    "\"\"\"\n",
    "funnel_df = pd.read_sql(funnel_query, conn)\n",
    "funnel_df['转化率'] = funnel_df['users'] / funnel_df['users'].iloc[0] * 100\n",
    "print(funnel_df)"
   ]
  },
