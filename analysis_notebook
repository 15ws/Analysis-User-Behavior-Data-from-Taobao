   "source": [
    "## 同期群留存热力图\n",
    "定义“首日购买”为用户首次购买日期，然后看他们在次日、3日、7日是否再次购买。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "60bb9af2",
   "metadata": {
    "vscode": {
     "languageId": "sql"
    }
   },
   "outputs": [],
   "source": [
    "# 先拿到每个用户首次购买日期\n",
    "first_buy = df[df.behavior=='buy'].groupby('user_id')['date'].min().reset_index()\n",
    "first_buy.columns = ['user_id','first_date']\n",
    "df_buy = df[df.behavior=='buy']\n",
    "df_buy = df_buy.merge(first_buy, on='user_id')\n",
    "df_buy['day_diff'] = (df_buy['date'] - df_buy['first_date']).dt.days\n",
    "\n",
    "# 生成留存矩阵\n",
    "cohort_matrix = df_buy.groupby(['first_date','day_diff']).agg(user_count=('user_id','nunique')).reset_index()\n",
    "cohort_pivot = cohort_matrix.pivot_table(index='first_date', columns='day_diff', values='user_count')\n",
    "cohort_pivot = cohort_pivot.div(cohort_pivot[0], axis=0)  # 除以首日人数\n",
    "# 用 seaborn 画热力图\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "plt.figure(figsize=(10,6))\n",
    "sns.heatmap(cohort_pivot, annot=True, fmt='.0%', cmap='YlGnBu')\n",
    "plt.title('用户购买同期群留存热力图')\n",
    "plt.show()"
   ]
  },
